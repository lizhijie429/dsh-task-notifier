{
  "name": "@lizhijie429/dsh-task-notifier",
  "version": "0.9.0",
  "description": "DSH Host plugin: monitor agent turn status, send OS notifications (Windows toasts branded with the DSH icon, click-to-focus, sound, reminders, localized copy, short session labels, privacy mode), alert pending approvals and user questions/plan reviews, auto-continue network/model-request failures, and expose a graphical settings page in the DSH Web client.",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./icon": "./assets/icon.png",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib",
    "vendor",
    "assets",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.1-0 <0.3.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "market:index": "node scripts/update-market-index.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notification",
    "toast",
    "auto-continue"
  ],
  "license": "MIT",
  "author": "lizhijie429",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lizhijie429/dsh-task-notifier.git"
  },
  "homepage": "https://github.com/lizhijie429/dsh-task-notifier#readme",
  "bugs": {
    "url": "https://github.com/lizhijie429/dsh-task-notifier/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}

